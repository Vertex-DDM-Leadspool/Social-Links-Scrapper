# ==============================================================================
# LeadsPool Social Scraper & CRM Database Enricher Configuration
# ==============================================================================
# Copy this file to .env and configure your database credentials.

# Option 1: Full PostgreSQL Connection URL:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/lead_crm?schema=public"

# Option 2: Or define individual PostgreSQL credentials:
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres"
# POSTGRES_HOST="127.0.0.1"
# POSTGRES_PORT="5432"
# POSTGRES_DB="lead_crm"
# POSTGRES_SCHEMA="public"

# Crawler concurrency & performance
CONCURRENCY=4
TIMEOUT_SECONDS=20
MAX_SUBPAGES=4

# Continuous Daemon Mode recurrence interval (in hours)
INTERVAL_HOURS=6.0
